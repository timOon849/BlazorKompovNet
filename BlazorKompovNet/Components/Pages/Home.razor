@page "/"
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDashboardService DashboardService
@inject IClubManagementService ClubManagementService
@inject AuthenticationStateProvider AuthenticationStateProvider
<PageTitle>Дашборд клуба</PageTitle>

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1>Дашборд клуба</h1>
        <p class="text-muted mb-0">Сводка по текущему клубу, смене и состоянию зала.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(notification))
{
    <div class="alert alert-info">@notification</div>
}

@if (stats is null)
{
    <p><em>Загрузка данных...</em></p>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-lg-6">
                    <p class="text-muted mb-1">Текущий клуб приложения</p>
                    <h2 class="h4 mb-1">@(stats.CurrentClub?.Name ?? "Клуб не выбран")</h2>
                    <p class="mb-0 text-muted">@(stats.CurrentClub?.Address ?? "Адрес не указан")</p>
                </div>

                <div class="col-sm-4 col-lg-2">
                    <div class="border rounded p-3">
                        <div class="text-muted small">ID клуба</div>
                        <div class="h5 mb-0">@(stats.CurrentClub?.Id.ToString() ?? "-")</div>
                    </div>
                </div>

                <div class="col-sm-4 col-lg-2">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Клубов в сети</div>
                        <div class="h5 mb-0">@stats.AvailableClubs.Count</div>
                    </div>
                </div>

                <div class="col-sm-4 col-lg-2">
                    <div class="border rounded p-3">
                        <div class="text-muted small">Статус</div>
                        <span class="badge @(stats.CurrentClub?.IsActive == true ? "text-bg-success" : "text-bg-secondary")">
                            @(stats.CurrentClub?.IsActive == true ? "Активен" : "Неактивен")
                        </span>
                    </div>
                </div>
            </div>

            @if (stats.AvailableClubs.Count > 1)
            {
                <div class="mt-3 pt-3 border-top">
                    <div class="text-muted small mb-2">Доступные клубы</div>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var club in stats.AvailableClubs)
                        {
                            <span class="badge @(club.Id == stats.CurrentClub?.Id ? "text-bg-primary" : "text-bg-secondary")">
                                @club.Name
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <p class="text-muted mb-1">Выручка за день</p>
                    <h2 class="h3 mb-0">@FormatMoney(stats.RevenueToday)</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Выручка смены</p>
                    <h2 class="h3 mb-0">@FormatMoney(stats.RevenueCurrentShift)</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Посетителей сегодня</p>
                    <h2 class="h3 mb-0">@stats.VisitorsToday</h2>
                    <p class="small text-muted mb-0">Сейчас в клубе: @stats.ActiveVisitors</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Бронирований сегодня</p>
                    <h2 class="h3 mb-0">@stats.BookingsToday</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Активных сессий</p>
                    <h2 class="h3 mb-0">@stats.ActiveSessionsCount</h2>
                    <p class="small text-muted mb-0">Завершено сегодня: @stats.CompletedSessionsToday</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Пополнений сегодня</p>
                    <h2 class="h3 mb-0">@stats.TopUpsToday</h2>
                    <p class="small text-muted mb-0">На сумму @FormatMoney(stats.TopUpAmountToday)</p>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Выключено</p>
                    <h2 class="h3 mb-0">@stats.DisabledComputers</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted mb-1">Справочник</p>
                    <a class="btn btn-outline-primary btn-sm" href="/tariffs">Тарифы клуба</a>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 mt-2">
        <div>
            <h2 class="h5 mb-1">Аналитика</h2>
            <p class="text-muted small mb-0">Динамика выручки, сеансов и загрузки зала за выбранный период.</p>
        </div>
        <div class="btn-group analytics-period" role="group" aria-label="Период аналитики">
            @foreach (var period in AnalyticsPeriods)
            {
                <button type="button"
                        class="btn btn-sm @(analyticsDays == period.Days ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => ChangeAnalyticsPeriodAsync(period.Days)">
                    @period.Label
                </button>
            }
        </div>
    </div>

    @if (analytics is null)
    {
        <p class="text-muted"><em>Загрузка графиков...</em></p>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h6 mb-1">Выручка по дням</h3>
                        <p class="text-muted small mb-3">Сумма оплаченных операций за @analytics.Days @FormatDays(analytics.Days).</p>
                        <DashboardChart ChartId="revenue-by-day"
                                        Type="line"
                                        Labels="@GetRevenueLabels()"
                                        Datasets="@GetRevenueDatasets()"
                                        Height="280px"/>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h6 mb-1">Сеансы по дням</h3>
                        <p class="text-muted small mb-3">Количество запущенных игровых сессий.</p>
                        <DashboardChart ChartId="sessions-by-day"
                                        Type="bar"
                                        Labels="@GetSessionLabels()"
                                        Datasets="@GetSessionDatasets()"
                                        Height="280px"/>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h6 mb-1">Состояние компьютеров</h3>
                        <p class="text-muted small mb-3">Текущее распределение ПК по статусам.</p>
                        @if (analytics.ComputerStatus.Count == 0)
                        {
                            <p class="text-muted mb-0">Нет данных о компьютерах.</p>
                        }
                        else
                        {
                            <DashboardChart ChartId="computer-status"
                                            Type="doughnut"
                                            Labels="@GetComputerStatusLabels()"
                                            Datasets="@GetComputerStatusDatasets()"
                                            Height="280px"/>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h6 mb-1">Выручка по способам оплаты</h3>
                        <p class="text-muted small mb-3">Структура оплат за @analytics.Days @FormatDays(analytics.Days).</p>
                        @if (analytics.RevenueByPaymentType.Count == 0)
                        {
                            <p class="text-muted mb-0">За выбранный период оплат не было.</p>
                        }
                        else
                        {
                            <DashboardChart ChartId="revenue-by-payment"
                                            Type="pie"
                                            Labels="@GetPaymentTypeLabels()"
                                            Datasets="@GetPaymentTypeDatasets()"
                                            Height="280px"/>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Состояние компьютеров</h2>

                    <div class="row text-center g-3 mt-1">
                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3">
                                <div class="h3 mb-0 text-success">@stats.AvailableComputers</div>
                                <div class="text-muted small">Свободно</div>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3">
                                <div class="h3 mb-0 text-primary">@stats.BusyComputers</div>
                                <div class="text-muted small">Занято</div>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3">
                                <div class="h3 mb-0 text-warning">@stats.ReservedComputers</div>
                                <div class="text-muted small">Бронь</div>
                            </div>
                        </div>

                        <div class="col-6 col-md-3">
                            <div class="border rounded p-3">
                                <div class="h3 mb-0 text-danger">@stats.MaintenanceComputers</div>
                                <div class="text-muted small">Ремонт</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5">Текущая смена</h2>

                    @if (stats.CurrentShift is null)
                    {
                        <div class="alert alert-warning">
                            Открытой смены нет. Кассовые операции недоступны до открытия смены.
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="openingCashAmount">Сумма в кассе на старте</label>
                            <input class="form-control" id="openingCashAmount" type="number" min="0" step="100" @bind="openingCashAmount" />
                        </div>

                        <button class="btn btn-primary" type="button" @onclick="OpenShiftAsync">Открыть смену</button>
                    }
                    else
                    {
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Кассир</dt>
                            <dd class="col-sm-7">@stats.CurrentShift.Cashier?.FullName</dd>

                            <dt class="col-sm-5">Открыта</dt>
                            <dd class="col-sm-7">@stats.CurrentShift.OpenedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                            <dt class="col-sm-5">Длительность</dt>
                            <dd class="col-sm-7">@FormatDuration(DateTime.UtcNow - stats.CurrentShift.OpenedAt)</dd>

                            <dt class="col-sm-5">Касса на старте</dt>
                            <dd class="col-sm-7">@FormatMoney(stats.CurrentShift.OpeningCashAmount)</dd>

                            <dt class="col-sm-5">Выручка смены</dt>
                            <dd class="col-sm-7">@FormatMoney(stats.RevenueCurrentShift)</dd>

                            <dt class="col-sm-5">Расчётная касса</dt>
                            <dd class="col-sm-7">@FormatMoney(expectedCashAmount)</dd>
                        </dl>

                        <div class="mt-3 pt-3 border-top">
                            @if (stats.ActiveSessionsCount > 0)
                            {
                                <div class="alert alert-warning py-2 small mb-2">
                                    Активных сессий: @stats.ActiveSessionsCount. Смену можно закрыть — новые кассовые операции будут недоступны до открытия следующей смены.
                                </div>
                            }

                            <label class="form-label" for="closingCashAmount">Фактическая сумма в кассе</label>
                            <input class="form-control mb-2" id="closingCashAmount" type="number" min="0" step="100" @bind="closingCashAmount" />
                            <button class="btn btn-outline-danger" type="button" @onclick="CloseShiftAsync">Закрыть смену</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DashboardStats? stats;
    private DashboardAnalytics? analytics;
    private int analyticsDays = 7;
    private string? notification;
    private decimal openingCashAmount;
    private decimal closingCashAmount;
    private decimal expectedCashAmount;

    private static readonly (int Days, string Label)[] AnalyticsPeriods =
    [
        (7, "7 дней"),
        (14, "14 дней"),
        (30, "30 дней")
    ];

    private static readonly string[] ChartPalette =
    [
        "#f97316",
        "#22c55e",
        "#3b82f6",
        "#f59e0b",
        "#ef4444",
        "#8b5cf6",
        "#14b8a6"
    ];

    private static readonly string[] StatusPalette =
    [
        "#22c55e",
        "#3b82f6",
        "#f59e0b",
        "#ef4444",
        "#94a3b8"
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            stats = await DashboardService.GetDashboardStatsAsync(authenticationState.User);
            analytics = await DashboardService.GetDashboardAnalyticsAsync(authenticationState.User, analyticsDays);

            if (stats.CurrentShift is not null)
            {
                var transactions = await ClubManagementService.GetTransactionsAsync();
                expectedCashAmount = ShiftAccounting.GetExpectedCashAmount(stats.CurrentShift, transactions);
                closingCashAmount = expectedCashAmount;
            }
            else
            {
                expectedCashAmount = 0;
                closingCashAmount = 0;
            }
        }
        catch (InvalidOperationException ex)
        {
            stats = new DashboardStats();
            analytics = new DashboardAnalytics { Days = analyticsDays };
            notification = ex.Message;
        }
    }

    private async Task ChangeAnalyticsPeriodAsync(int days)
    {
        if (analyticsDays == days)
        {
            return;
        }

        analyticsDays = days;
        analytics = null;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            analytics = await DashboardService.GetDashboardAnalyticsAsync(authenticationState.User, analyticsDays);
        }
        catch (InvalidOperationException ex)
        {
            analytics = new DashboardAnalytics { Days = analyticsDays };
            notification = ex.Message;
        }
    }

    private string[] GetRevenueLabels() =>
        analytics?.RevenueByDay.Select(point => point.Label).ToArray() ?? [];

    private ChartDatasetConfig[] GetRevenueDatasets() =>
    [
        new ChartDatasetConfig
        {
            Label = "Выручка, ₽",
            Data = analytics?.RevenueByDay.Select(point => (double)point.Amount).ToArray() ?? [],
            BorderColor = "#f97316",
            BackgroundColor = "rgba(249, 115, 22, 0.18)",
            BorderWidth = 2,
            Fill = true,
            Tension = 0.35
        }
    ];

    private string[] GetSessionLabels() =>
        analytics?.SessionsByDay.Select(point => point.Label).ToArray() ?? [];

    private ChartDatasetConfig[] GetSessionDatasets() =>
    [
        new ChartDatasetConfig
        {
            Label = "Сеансы",
            Data = analytics?.SessionsByDay.Select(point => (double)point.Count).ToArray() ?? [],
            BackgroundColor = "rgba(59, 130, 246, 0.75)",
            BorderColor = "#3b82f6",
            BorderWidth = 1
        }
    ];

    private string[] GetComputerStatusLabels() =>
        analytics?.ComputerStatus.Select(point => point.Name).ToArray() ?? [];

    private ChartDatasetConfig[] GetComputerStatusDatasets() =>
    [
        new ChartDatasetConfig
        {
            Data = analytics?.ComputerStatus.Select(point => (double)point.Count).ToArray() ?? [],
            BackgroundColor = StatusPalette.Take(analytics?.ComputerStatus.Count ?? 0).ToArray(),
            BorderColor = "#ffffff",
            BorderWidth = 2
        }
    ];

    private string[] GetPaymentTypeLabels() =>
        analytics?.RevenueByPaymentType.Select(point => point.Name).ToArray() ?? [];

    private ChartDatasetConfig[] GetPaymentTypeDatasets() =>
    [
        new ChartDatasetConfig
        {
            Data = analytics?.RevenueByPaymentType.Select(point => (double)point.Amount).ToArray() ?? [],
            BackgroundColor = ChartPalette.Take(analytics?.RevenueByPaymentType.Count ?? 0).ToArray(),
            BorderColor = "#ffffff",
            BorderWidth = 2
        }
    ];

    private static string FormatDays(int days) =>
        days switch
        {
            1 => "день",
            var value when value % 10 == 1 && value % 100 != 11 => "день",
            var value when value % 10 is >= 2 and <= 4 && (value % 100 < 10 || value % 100 >= 20) => "дня",
            _ => "дней"
        };

    private async Task OpenShiftAsync()
    {
        var cashError = InputValidators.ShiftCashAmount(openingCashAmount);
        if (cashError is not null)
        {
            notification = cashError;
            return;
        }

        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var cashierId = GetCashierId(authenticationState.User);
        var result = await ClubManagementService.OpenShiftAsync(cashierId, openingCashAmount);

        notification = result.Message;
        if (result.Succeeded)
        {
            openingCashAmount = 0;
        }

        await LoadStatsAsync();
    }

    private async Task CloseShiftAsync()
    {
        if (stats?.CurrentShift is null)
        {
            notification = "Открытая смена не найдена.";
            return;
        }

        var cashError = InputValidators.ShiftCashAmount(closingCashAmount);
        if (cashError is not null)
        {
            notification = cashError;
            return;
        }

        var result = await ClubManagementService.CloseShiftAsync(stats.CurrentShift.Id, closingCashAmount);
        notification = result.Message;
        await LoadStatsAsync();
    }

    private static int GetCashierId(System.Security.Claims.ClaimsPrincipal user)
    {
        var cashierIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        return int.TryParse(cashierIdClaim, out var cashierId) ? cashierId : 0;
    }

    private static string FormatMoney(decimal value)
    {
        return $"{value:N0}₽";
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1
            ? $"{(int)duration.TotalHours} ч {duration.Minutes} мин"
            : $"{duration.Minutes} мин";
    }
}
